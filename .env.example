# Jira credentials for local development
JIRA_SERVER=https://your-company.atlassian.net
JIRA_EMAIL=your.name@company.com
JIRA_API_TOKEN=your_jira_api_token

# Safe-mode Jira writes (see README "Local-only switches"): Target date updates and forecast comments (Backlog),
# Assign in Jira (Suggested Assignments). Off unless true. Only works from the machine running the app (localhost).
JIRA_WRITE_ENABLED=false

# The Executive Report panel on the Executive Summary page. Off unless true; localhost only.
EXECUTIVE_REPORT_ENABLED=false
